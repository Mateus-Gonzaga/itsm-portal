# Modelo de .env para PRODUÇÃO. Copie para .env e preencha:
#   cp .env.prod.example .env  &&  nano .env
# NUNCA versione o .env real (ele tem senhas).

APP_NAME="FOURLINE Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SEU_IP:8088

# Banco do portal (PostgreSQL no container db) — troque a senha.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=itsm
DB_USERNAME=itsm
DB_PASSWORD=TROQUE_ESTA_SENHA

# Sessão e fila no banco; CACHE no Redis (container "redis" do compose).
# Só troque CACHE_STORE para redis DEPOIS de reconstruir a imagem
# (docker compose ... build app scheduler) — ela precisa da extensão phpredis.
SESSION_DRIVER=database
CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Cache das leituras do GLPI (false desliga).
GLPI_CACHE=true

# Avisos de erro do portal por e-mail (vazio = usa MAIL_FROM_ADDRESS; "off" desliga).
ERROR_ALERT_EMAIL=

# Monitoramento do portal no Zabbix (comando monitor:zabbix-portal).
# Usuário com permissão de escrita no Zabbix (criar host/cenário/trigger/ação).
PORTAL_PUBLIC_URL=http://suporte.fourline.com.br:8083

# GLPI de produção (conta de serviço RESTRITA, não super-admin).
GLPI_DRIVER=api
GLPI_API_URL=http://IP_DA_VM_GLPI/apirest.php
GLPI_API_USER=conta_servico
GLPI_API_PASSWORD=
GLPI_TIMEZONE=UTC

# Zabbix de produção (usuário só-leitura).
ZABBIX_DRIVER=api
ZABBIX_API_URL=http://192.168.101.26/api_jsonrpc.php
ZABBIX_USER=
ZABBIX_PASSWORD=

# --- Google Calendar (sincronizacao da agenda com o calendario da equipe) ---
# Ligue (true) apenas apos criar a conta de servico e compartilhar o calendario com ela.
GOOGLE_CALENDAR_SYNC=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_KEY_PATH=/var/www/html/storage/app/google-service-account.json

# --- Envio de E-mails (SMTP) ---
# Disparo imediato na abertura de chamados para cliente e equipe.
MAIL_MAILER=smtp
MAIL_HOST=smtp.kinghost.net
MAIL_PORT=587
MAIL_USERNAME=contato@fourline.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contato@fourline.com.br
MAIL_FROM_NAME="Suporte TI - Fourline"

